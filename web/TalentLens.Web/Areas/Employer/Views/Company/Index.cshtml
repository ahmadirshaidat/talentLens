@model CompanyEditModel
@{
    ViewData["Title"] = T["CompanyProfile"];
    var status = (CompanyStatus)ViewData["Status"]!;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h4 mb-0">@T["CompanyProfile"]</h1>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge @(status == CompanyStatus.Active ? "text-bg-success" : "text-bg-warning")">@T[$"CompanyStatus{status}"]</span>
        @if (status == CompanyStatus.Active)
        {
            <a class="btn btn-sm btn-outline-secondary" asp-area="" asp-controller="Companies" asp-action="Details" asp-route-id="@ViewData["CompanyId"]">@T["ViewPublicPage"]</a>
        }
    </div>
</div>

<form method="post" class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label">@T["CompanyName"]</label>
                <input asp-for="Name" class="form-control" dir="auto" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Industry" class="form-label">@T["Industry"]</label>
                <input asp-for="Industry" class="form-control" dir="auto" />
            </div>
            <div class="col-md-4">
                <label asp-for="Size" class="form-label">@T["CompanySize"]</label>
                <select asp-for="Size" class="form-select">
                    <option value="">—</option>
                    @foreach (var s in new[] { "1-10", "11-50", "51-200", "201-500", "500+" }) { <option value="@s">@s</option> }
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Location" class="form-label">@T["Location"]</label>
                <input asp-for="Location" class="form-control" dir="auto" />
            </div>
            <div class="col-md-4">
                <label asp-for="Website" class="form-label">@T["Website"]</label>
                <input asp-for="Website" class="form-control" dir="ltr" placeholder="https://" />
                <span asp-validation-for="Website" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label">@T["AboutCompany"]</label>
                <textarea asp-for="Description" rows="5" class="form-control" dir="auto"></textarea>
            </div>
        </div>
    </div>
    <div class="card-footer bg-transparent text-end"><button class="btn btn-primary">@T["Save"]</button></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
