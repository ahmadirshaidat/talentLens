@model CandidateListViewModel
@{
    ViewData["Title"] = T["TalentPool"];
}

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
    <h1 class="h4 mb-0">@T["TalentPool"] <span class="text-muted fs-6">(@Model.TotalCount)</span></h1>
    <a class="btn btn-primary" asp-action="Upload">@T["UploadCvs"]</a>
</div>
<p class="small text-muted">@T["TalentPoolHint"]</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-5">
        <input type="search" name="q" value="@Model.Query" class="form-control" dir="auto" placeholder="@T["FilterByName"]" />
    </div>
    <div class="col-sm-4 col-md-3">
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">@T["AllStatuses"]</option>
            @foreach (var s in Enum.GetValues<ProcessingStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@T[$"Status{s}"]</option>
            }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">@T["Filter"]</button></div>
</form>

@if (Model.Candidates.Count == 0)
{
    <div class="text-center text-muted py-5 border rounded-3 bg-white">
        <p class="mb-3">@T["NoCandidatesYet"]</p>
        <a class="btn btn-primary" asp-action="Upload">@T["UploadCvs"]</a>
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="table-light">
                <tr>
                    <th>@T["Name"]</th>
                    <th class="d-none d-md-table-cell">@T["Experience"]</th>
                    <th class="d-none d-lg-table-cell">@T["Skills"]</th>
                    <th>@T["Status"]</th>
                    <th class="d-none d-sm-table-cell">@T["Uploaded"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Candidates)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@c.Id" class="fw-semibold" dir="auto">@c.DisplayName</a>
                            @if (c.JobTitles.Count > 0) { <div class="small text-muted" dir="auto">@c.JobTitles[0]</div> }
                        </td>
                        <td class="d-none d-md-table-cell">@(c.YearsOfExperience is double y ? T.F("YearsShort", y) : "—")</td>
                        <td class="d-none d-lg-table-cell">
                            <partial name="_Chips" model="c.Skills.Take(5)" />
                            @if (c.Skills.Count > 5) { <span class="small text-muted">+@(c.Skills.Count - 5)</span> }
                        </td>
                        <td><partial name="_StatusBadge" model="c.Status" /></td>
                        <td class="d-none d-sm-table-cell small text-muted">@T.Ago(c.UploadedAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="pages">
            <ul class="pagination justify-content-center">
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-q="@Model.Query" asp-route-status="@Model.Status">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}

@if (Model.HasInProgress)
{
    <p class="small text-muted mt-3" data-auto-refresh="5000">@T["AutoRefresh"]</p>
}
