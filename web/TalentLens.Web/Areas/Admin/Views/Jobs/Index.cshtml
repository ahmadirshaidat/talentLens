@model IReadOnlyList<AdminJobRow>
@{
    ViewData["Title"] = T["Jobs"];
    var status = ViewData["Status"] as JobStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0">@T["Jobs"] <span class="text-muted fs-6">(@Model.Count)</span></h1>
    <form method="get" class="d-flex gap-2">
        <input type="hidden" name="status" value="@status" />
        <input type="search" name="q" value="@ViewData["Q"]" class="form-control form-control-sm" dir="auto" placeholder="@T["SearchJobsAdmin"]" />
        <button class="btn btn-sm btn-primary">@T["Search"]</button>
    </form>
</div>

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link @(status is null ? "active" : "")" asp-action="Index">@T["All"]</a></li>
    @foreach (var s in Enum.GetValues<JobStatus>())
    {
        <li class="nav-item"><a class="nav-link @(status == s ? "active" : "")" asp-action="Index" asp-route-status="@s">@T[$"Job{s}"]</a></li>
    }
</ul>

<div class="table-responsive shadow-sm rounded-3">
    <table class="table align-middle mb-0 bg-white">
        <thead class="table-light">
            <tr>
                <th>@T["JobTitle"]</th>
                <th>@T["Company"]</th>
                <th>@T["Status"]</th>
                <th>@T["Applicants"]</th>
                <th class="d-none d-md-table-cell">@T["Posted"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                var j = row.Job;
                <tr>
                    <td dir="auto">
                        @if (j.Status == JobStatus.Open)
                        {
                            <a asp-area="" asp-controller="Jobs" asp-action="Details" asp-route-id="@j.Id">@j.Title</a>
                        }
                        else { @j.Title }
                    </td>
                    <td dir="auto" class="small">@j.Company?.Name</td>
                    <td><span class="badge @(j.Status == JobStatus.Open ? "text-bg-success" : "text-bg-light border")">@T[$"Job{j.Status}"]</span></td>
                    <td>@row.Applicants</td>
                    <td class="d-none d-md-table-cell small text-muted">@(j.PublishedAt is DateTime d ? T.Ago(d) : "—")</td>
                    <td class="text-end">
                        @if (j.Status == JobStatus.Open)
                        {
                            <form asp-action="Close" asp-route-id="@j.Id" method="post" class="d-inline" data-confirm="@T["ConfirmCloseJob"]">
                                <button class="btn btn-sm btn-outline-danger">@T["CloseJob"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
