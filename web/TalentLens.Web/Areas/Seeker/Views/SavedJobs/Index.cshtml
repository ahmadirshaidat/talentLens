@model IReadOnlyList<Job>
@{
    ViewData["Title"] = T["SavedJobs"];
}

<h1 class="h4 mb-4">@T["SavedJobs"] <span class="text-muted fs-6">(@Model.Count)</span></h1>

@foreach (var job in Model)
{
    <partial name="_JobCard" model="job" view-data="@(new ViewDataDictionary(ViewData) { ["Saved"] = true })" />
}
@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5 border rounded-3 bg-white">@T["NoSavedJobs"]</div>
}
