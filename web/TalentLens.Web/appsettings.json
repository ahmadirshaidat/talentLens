{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=TalentLens;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "",
    "TimeoutSeconds": 300
  },
  "Storage": {
    "UploadsPath": "App_Data/uploads",
    "MaxUploadMb": 10
  },
  "Security": {
    "MalwareScanning": {
      "Provider": "None",
      "Host": "localhost",
      "Port": 3310,
      "TimeoutSeconds": 30,
      "FailClosed": true
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalPerMinute": 300,
    "AuthPerMinute": 10,
    "AiPerMinute": 20,
    "UploadsPerTenMinutes": 30
  },
  "Hangfire": {
    "WorkerCount": 2
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*"
}
