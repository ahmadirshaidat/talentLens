@{
    ViewData["Title"] = T["ForEmployers"];
}

@section Hero {
    <section class="tl-hero-band tl-hero-employer">
        <div class="container py-5">
            <h1 class="display-6 fw-bold mb-2">@T["EmployerHeroTitle"]</h1>
            <p class="lead mb-4 tl-narrow">@T["EmployerHeroText"]</p>
            <a class="btn btn-accent btn-lg" asp-controller="Account" asp-action="RegisterEmployer">@T["PostJobFree"]</a>
            <a class="btn btn-outline-light btn-lg ms-2" asp-controller="Account" asp-action="Login">@T["Login"]</a>
        </div>
    </section>
}

<div class="row g-4">
    @foreach (var i in new[] { 1, 2, 3, 4 })
    {
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="tl-step">@i</div>
                    <h5 class="card-title">@T[$"EmpFeature{i}Title"]</h5>
                    <p class="card-text text-muted small">@T[$"EmpFeature{i}Text"]</p>
                </div>
            </div>
        </div>
    }
</div>
