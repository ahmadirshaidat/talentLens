@model IReadOnlyList<CompanyCard>
@{
    ViewData["Title"] = T["Companies"];
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0">@T["Companies"]</h1>
    <form method="get" class="d-flex gap-2">
        <input type="search" name="q" value="@ViewData["Q"]" class="form-control" dir="auto" placeholder="@T["SearchCompanies"]" />
        <button class="btn btn-primary">@T["Search"]</button>
    </form>
</div>

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body d-flex gap-3">
                    <partial name="_CompanyLogo" model="c.Company" />
                    <div class="min-w-0">
                        <a asp-action="Details" asp-route-id="@c.Company.Id" class="fw-semibold stretched-link" dir="auto">@c.Company.Name</a>
                        <div class="small text-muted" dir="auto">@c.Company.Industry · @c.Company.Location</div>
                        <span class="badge tl-tag mt-2">@T.F("JobsCount", c.OpenJobs)</span>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (Model.Count == 0)
    {
        <div class="text-muted">@T["NoCompanies"]</div>
    }
</div>
