@model JobSearchViewModel
@{
    ViewData["Title"] = T["FindJobs"];
}

<form method="get" class="tl-searchbar shadow-sm mb-4">
    <div class="row g-0">
        <div class="col-md-6">
            <input name="q" value="@Model.Q" class="form-control form-control-lg border-0" dir="auto"
                   placeholder="@T["JobKeywordPlaceholder"]" aria-label="@T["JobKeywordPlaceholder"]" />
        </div>
        <div class="col-md-4 tl-divider">
            <input name="location" value="@Model.Location" class="form-control form-control-lg border-0" dir="auto"
                   placeholder="@T["LocationPlaceholder"]" aria-label="@T["Location"]" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-accent btn-lg" type="submit">@T["SearchJobs"]</button>
        </div>
    </div>
    <input type="hidden" name="type" value="@Model.Type" />
    <input type="hidden" name="workplace" value="@Model.Workplace" />
</form>

<div class="row g-4">
    <aside class="col-lg-3">
        <form method="get" class="card border-0 shadow-sm">
            <input type="hidden" name="q" value="@Model.Q" />
            <input type="hidden" name="location" value="@Model.Location" />
            <div class="card-body">
                <h2 class="h6">@T["JobType"]</h2>
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="type" id="type-any" value="" checked="@(Model.Type is null)" onchange="this.form.submit()" />
                        <label class="form-check-label" for="type-any">@T["Any"]</label>
                    </div>
                    @foreach (var t in Enum.GetValues<EmploymentType>())
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="type" id="type-@t" value="@t" checked="@(Model.Type == t)" onchange="this.form.submit()" />
                            <label class="form-check-label" for="type-@t">@T[$"Type{t}"]</label>
                        </div>
                    }
                </div>
                <h2 class="h6">@T["Workplace"]</h2>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="workplace" id="wp-any" value="" checked="@(Model.Workplace is null)" onchange="this.form.submit()" />
                    <label class="form-check-label" for="wp-any">@T["Any"]</label>
                </div>
                @foreach (var w in Enum.GetValues<WorkplaceType>())
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="workplace" id="wp-@w" value="@w" checked="@(Model.Workplace == w)" onchange="this.form.submit()" />
                        <label class="form-check-label" for="wp-@w">@T[$"Workplace{w}"]</label>
                    </div>
                }
            </div>
        </form>
    </aside>

    <div class="col-lg-9">
        <p class="text-muted small mb-3">@T.F("JobsFound", Model.TotalCount)</p>
        @foreach (var job in Model.Jobs)
        {
            <partial name="_JobCard" model="job" view-data="@(new ViewDataDictionary(ViewData) { ["Saved"] = Model.SavedIds.Contains(job.Id), ["Applied"] = Model.AppliedIds.Contains(job.Id) })" />
        }
        @if (Model.Jobs.Count == 0)
        {
            <div class="text-center text-muted py-5 border rounded-3 bg-white">@T["NoJobsFound"]</div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="pages">
                <ul class="pagination justify-content-center">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-route-page="@p" asp-route-q="@Model.Q" asp-route-location="@Model.Location"
                               asp-route-type="@Model.Type" asp-route-workplace="@Model.Workplace">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
