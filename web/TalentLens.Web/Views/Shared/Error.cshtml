@model ErrorViewModel
@{
    ViewData["Title"] = T["Error"];
}

<div class="text-center py-5">
    <h1 class="display-6 text-danger">@T["Error"]</h1>
    <p class="lead">@T["ErrorText"]</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">@T["BackHome"]</a>
</div>
