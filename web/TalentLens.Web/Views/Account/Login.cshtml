@model LoginViewModel
@{
    ViewData["Title"] = T["Login"];
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">@T["Login"]</h1>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">@T["Email"]</label>
                        <input asp-for="Email" class="form-control" autocomplete="username" dir="ltr" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">@T["Password"]</label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" dir="ltr" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">@T["RememberMe"]</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@T["Login"]</button>
                </form>
                <p class="mt-3 mb-0 small text-center">
                    @T["NoAccount"] <a asp-action="Register">@T["Register"]</a>
                </p>
                <p class="mt-1 mb-0 small text-center">
                    @T["AreYouEmployer"] <a asp-action="RegisterEmployer">@T["RegisterAsEmployer"]</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
